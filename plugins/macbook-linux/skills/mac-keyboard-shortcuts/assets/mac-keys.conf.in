# keyd config: macOS-style shortcuts on Linux
# Generated by mac-keyboard-shortcuts (make-config.sh) for desktop: @DESKTOP@

[ids]
*

[main]
# Command keys act as Ctrl for everything not listed below (Cmd+C, Cmd+V, Cmd+Shift+Z...)
leftmeta = layer(cmd)
rightmeta = layer(cmd)
# Left Option gets Mac text navigation. Right Option is left alone so it keeps working as AltGr.
leftalt = layer(opt)
@RIGHTALT@

[cmd:C]
# Cmd+Tab / Cmd+` : app switcher and same-app window switcher (switcher stays open while Cmd is held)
tab = swapm(app_switch, @SW@-tab)
` = swapm(app_switch, @SW@-grave)
# Cmd+Space : app search (like Spotlight)
space = @SPACE@
# Cmd+Q quit, Cmd+H hide, Cmd+M minimize
q = A-f4
@MINIMIZE@
# Cmd+arrows : line/document start and end
left = home
right = end
up = C-home
down = C-end
# Cmd+Backspace : delete to start of line
backspace = macro(S-home backspace)

[cmd+shift]
left = S-home
right = S-end
up = C-S-home
down = C-S-end
# Cmd+Shift+3 full screenshot, Cmd+Shift+4/5 screenshot tool
3 = S-print
4 = print
5 = print

[cmd+control]
# Ctrl+Cmd+Q : lock screen
q = M-l
# Ctrl+Cmd+F : toggle fullscreen
f = f11

[app_switch:@SW@]
tab = @SW@-tab
` = @SW@-grave

[opt:A]
# Option+arrows : word jumps, Option+Backspace/Delete : delete word
left = C-left
right = C-right
backspace = C-backspace
delete = C-delete

[opt+shift]
left = C-S-left
right = C-S-right
